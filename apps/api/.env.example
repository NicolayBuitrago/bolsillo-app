# --- Required -------------------------------------------------------------
# Postgres from infra/docker-compose.dev.yml
DATABASE_URL=postgres://bolsillo:bolsillo@localhost:5433/bolsillo
# Origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3100
# Session signing secret, at least 32 random characters (`openssl rand -base64 32`).
# Development-only value; generate a new one for any other environment.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public URL of this API
BETTER_AUTH_URL=http://localhost:3000

# --- Optional (defaults shown) --------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Phase 3: captures ------------------------------------------------------
DEDUP_WINDOW_MINUTES=15

# --- Phase 4: optional LLM extraction (disabled without a key) -------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_DAILY_LIMIT_PER_USER=50

# --- Phase 5: email capture -------------------------------------------------
# Shared HMAC secret with infra/email-worker
EMAIL_WEBHOOK_SECRET=
# Domain of the per-user capture addresses
EMAIL_CAPTURE_DOMAIN=
