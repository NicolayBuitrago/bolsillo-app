# --- Required -------------------------------------------------------------
# Postgres from infra/docker-compose.dev.yml
DATABASE_URL=postgres://bolsillo:bolsillo@localhost:5433/bolsillo
# Origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3001

# --- Optional (defaults shown) --------------------------------------------
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Phase 1: Better Auth ---------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of this API
BETTER_AUTH_URL=http://localhost:3000

# --- Phase 3: captures ------------------------------------------------------
DEDUP_WINDOW_MINUTES=15

# --- Phase 4: optional LLM extraction (disabled without a key) -------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_DAILY_LIMIT_PER_USER=50

# --- Phase 5: email capture -------------------------------------------------
# Shared HMAC secret with infra/email-worker
EMAIL_WEBHOOK_SECRET=
# Domain of the per-user capture addresses
EMAIL_CAPTURE_DOMAIN=
