{
  "name": "@bolsillo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/expo": "1.7.14",
    "@bolsillo/core": "workspace:*",
    "@bolsillo/db": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.14",
    "hono": "4.13.14",
    "node-cron": "4.6.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bolsillo/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
