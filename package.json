{
  "name": "bolsillo",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @bolsillo/db db:generate",
    "db:migrate": "pnpm --filter @bolsillo/db db:migrate",
    "db:seed": "pnpm --filter @bolsillo/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@bolsillo/config": "workspace:*",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
